#!/bin/sh
# SPDX-FileCopyrightText: 2026 Joseph Saiko <https://saiko.dev>
# SPDX-License-Identifier: GPL-3.0-only
set -e

case "$1" in
purge)
    # Generated by postinst. The database in /var/lib/veil, the veil user
    # and the ghost-admins group are deliberately left.
    rm -f /etc/ghost/veil-cert.pem /etc/ghost/veil-key.pem \
          /etc/ghost/veil-web-cert.pem /etc/ghost/veil-web-key.pem \
          /etc/ghost/veil-wisp.key
    rmdir --ignore-fail-on-non-empty /etc/ghost 2>/dev/null || true
    ;;
esac

#DEBHELPER#

exit 0
