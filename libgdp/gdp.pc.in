prefix=@CMAKE_INSTALL_PREFIX@
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: gdp
Description: Ghost Display Protocol client/server library (static)
Version: @GDP_PC_VERSION@
Requires: protobuf libzstd libngtcp2 libngtcp2_crypto_ossl openssl
Libs: -L${libdir} -lgdp -lpthread
Cflags: -I${includedir} -I${includedir}/gdp/proto
