#!/bin/sh
# SPDX-FileCopyrightText: 2026 Joseph Saiko <https://saiko.dev>
# SPDX-License-Identifier: GPL-3.0-only
# Run as root before labwc: force every connected display connector but the
# first (card, then connector id) off, so labwc only ever sees one monitor
# and spectre and the greeter go fullscreen on it. Otherwise the pointer
# could wander off onto the others' empty desktop.
for dir in /sys/class/drm/card[0-9]*-*; do
	[ "$(cat "$dir/status" 2>/dev/null)" = connected ] || continue
	name=${dir##*/}
	printf '%s %s %s\n' "${name%%-*}" "$(cat "$dir/connector_id" 2>/dev/null || echo 0)" "$dir"
done | sort -k1,1V -k2,2n | tail -n +2 | while read -r card id dir; do
	echo off > "$dir/status"
done
exit 0
