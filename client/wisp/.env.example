# Read by docker compose from this directory (works under sudo).
VEIL_HOST=veil.example:4442
# Both of these come from the Veil host: `veild wisp-env >> .env` prints them.
# SHA-256 fingerprint of Veil's certificate (64 hex digits, colons allowed).
# Required: clients refuse to connect to a Veil they cannot verify.
VEIL_CERT_SHA256=
# The key every client presents to Veil to report in and get its settings
# (/etc/ghost/veil-wisp.key on the Veil host). Required.
WISP_KEY=
# Optional. NTP servers for the clients, space or comma separated
# (e.g. "ntp1.example.com 192.0.2.10"). Replaces whatever DHCP offers; unset,
# clients use the NTP servers from DHCP, else Debian's pool.
#WISP_NTP=
# Optional. Extra kernel arguments for every client, space separated, e.g.
# nouveau.runpm=0 (a workaround for nouveau failing to wake after the display
# sleeps). Letters, digits and . _ = , : / + @ - only.
#WISP_KERNEL_ARGS=
# Optional. WISP_SHELL=1: a root shell on the clients' tty2 and serial
# console, for debugging (anyone at the keyboard gets root).
#WISP_SHELL=0
# Optional, with WISP_SHELL=1: which clients get the kernel console on the
# serial port (what the serial login needs). qemu (default): only QEMU
# guests. all: every client, for a real serial line. off: none. On real
# hardware without a cable the console can slow or stall the boot.
#WISP_SERIAL_CONSOLE=qemu
# Optional. TFTP_PORT other than 69 only works if clients reach it through a
# port mapping: firmware and iPXE always use 69.
#HTTP_PORT=80
#TFTP_PORT=69
